---
interface Props {
  title?: string;
}
const { title = "Office" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: system-ui, sans-serif;
  }

  #perfBadge {
    position: fixed;
    top: 10px;
    right: 10px;
    z-index: 9999;
    padding: 6px 10px;
    border-radius: 6px;
    font: 11px/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #dce8ff;
    background: rgba(8, 12, 22, 0.72);
    border: 1px solid rgba(120, 160, 255, 0.25);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    white-space: pre-line;
  }

  #perfBadge.visible {
    opacity: 1;
  }

  .office-scene-root canvas {
    display: block;
  }
</style>
