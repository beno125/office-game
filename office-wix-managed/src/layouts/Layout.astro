---
interface Props {
  title?: string;
}
const { title = "Office" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: system-ui, sans-serif;
    /* Match scene root so the page is not pure white before React / WebGL mount */
    background: #1a1a1a;
    color: #e8e8e8;
  }

  #perfBadge {
    position: fixed;
    top: 10px;
    right: 10px;
    z-index: 9999;
    padding: 6px 10px;
    border-radius: 10px;
    font: 11px/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--wx-text-2, #dce8ff);
    background: var(--wx-surface-strong, rgba(8, 12, 22, 0.72));
    border: 1px solid var(--wx-hairline, rgba(120, 160, 255, 0.25));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    white-space: pre-line;
  }

  #perfBadge.visible {
    opacity: 1;
  }






  .world-transition {
    position: fixed;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #000;
  }

  .world-transition-stars {
    position: absolute;
    inset: -20%;
    background-image:
      radial-gradient(circle, #fff 0 1px, transparent 1.8px),
      radial-gradient(circle, #7ee8ff 0 1.2px, transparent 2px),
      radial-gradient(circle, #da75ff 0 1px, transparent 1.8px);
    background-position: 0 0, 47px 71px, 91px 23px;
    background-size: 83px 83px, 137px 137px, 109px 109px;
    animation: transition-stars-rush 3.6s linear infinite;
    opacity: 0.75;
  }

  .world-transition-vortex {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 125vmax;
    height: 125vmax;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: repeating-conic-gradient(
      from 20deg,
      transparent 0 7deg,
      rgba(92, 227, 255, 0.8) 9deg,
      rgba(171, 70, 255, 0.9) 12deg,
      transparent 17deg 28deg
    );
    -webkit-mask-image: radial-gradient(
      circle,
      transparent 0 15%,
      #000 23% 70%,
      transparent 82%
    );
    mask-image: radial-gradient(
      circle,
      transparent 0 15%,
      #000 23% 70%,
      transparent 82%
    );
    filter: blur(3px) saturate(1.35);
    mix-blend-mode: screen;
    opacity: 0.72;
  }

  .world-transition-vortex-a {
    animation: transition-vortex-spin 6s linear infinite;
  }

  .world-transition-vortex-b {
    width: 92vmax;
    height: 92vmax;
    background: repeating-conic-gradient(
      from 210deg,
      transparent 0 10deg,
      rgba(255, 91, 238, 0.9) 12deg,
      rgba(91, 172, 255, 0.9) 15deg,
      transparent 19deg 35deg
    );
    animation: transition-vortex-spin-reverse 4.5s linear infinite;
    opacity: 0.8;
  }

  .world-transition-tunnel {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgba(2, 0, 22, 0.72) 0 10%, transparent 29%),
      repeating-radial-gradient(
        circle at center,
        transparent 0 6%,
        rgba(119, 71, 255, 0.22) 7%,
        transparent 9% 14%
      );
    animation: transition-tunnel-pulse 1.2s ease-in-out infinite alternate;
  }

  .world-transition-strips {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    perspective: 800px;
    transform-style: flat;
    contain: strict;
    isolation: isolate;
    pointer-events: none;
  }

  .world-transition-strips span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--strip-width);
    height: var(--strip-length);
    border-radius: 999px;
    background: var(--strip-color);
    box-shadow: 0 0 5px var(--strip-color), 0 0 10px var(--strip-color);
    opacity: 0;
    transform-origin: 50% 0;
    backface-visibility: hidden;
    animation: transition-strip-flight var(--strip-duration)
      linear var(--strip-delay) infinite; /* the curve is in the keyframes (was cubic-bezier(0.55, 0.02, 1, 0.42)) */
  }

  .world-transition-car {
    position: absolute;
    z-index: 3;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .world-transition-car canvas {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 24px 28px rgba(0, 0, 0, 0.5));
  }

  .world-transition-copy {
    position: absolute;
    z-index: 4;
    top: clamp(1.5rem, 6vh, 4rem);
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%) translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
    text-align: center;
    text-transform: uppercase;
    text-shadow: 0 4px 20px #100028;
  }

  .world-transition-copy span {
    font: 800 clamp(0.72rem, 1.3vw, 1rem)/1 system-ui, sans-serif;
    letter-spacing: 0.38em;
    opacity: 0.8;
  }

  .world-transition-copy strong {
    margin-top: 0.35rem;
    font: 1000 clamp(2.2rem, 7vw, 5.8rem)/0.9 system-ui, sans-serif;
    letter-spacing: -0.055em;
    -webkit-text-stroke: clamp(1px, 0.14vw, 3px) #fff;
    color: #9f6cff;
  }

  @keyframes transition-vortex-spin {
    to { transform: translate(-50%, -50%) rotate(360deg) scale(1.08); }
  }

  @keyframes transition-vortex-spin-reverse {
    to { transform: translate(-50%, -50%) rotate(-360deg) scale(1.12); }
  }

  @keyframes transition-stars-rush {
    to { transform: scale(1.22) rotate(3deg); }
  }

  @keyframes transition-tunnel-pulse {
    to { transform: scale(1.08); filter: brightness(1.25); }
  }

  /*
   * Generated (same path as cubic-bezier(0.55, 0.02, 1, 0.42) over the whole flight, opacity 0 → 0.95 by 8%,
   * → 1 by 88%, → 0 at 100%): sampled densely so the linear timing follows it. A strip is never drawn
   * narrower than 1.1px on screen (it was 0.2–0.9px for the first ~60% of its flight, so it fell between
   * pixels and flickered); where it's widened, its opacity drops by the same factor (same brightness).
   */
