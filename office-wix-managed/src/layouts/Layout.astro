    0% {
      opacity: calc(0 * min(1, var(--strip-w) * 0.08696 / 1.1));
      transform: rotate(var(--strip-angle)) translateY(calc(var(--strip-start) * 1 + 132vmax * 0))
        translateZ(-1500px) scaleX(max(0.25, 3.1625 / var(--strip-w))) scaleY(0.06);
    }
    1% {
      opacity: calc(0.0107 * min(1, var(--strip-w) * 0.08759 / 1.1));
      transform: rotate(var(--strip-angle)) translateY(calc(var(--strip-start) * 0.99959 + 132vmax * 0.00041))
